# Production Environment Variables for News Agent Backend

# Database (Production: PostgreSQL on Railway)
DATABASE_URL=postgresql://user:password@railway-host/newsagent

# JWT Security (Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=your-production-secret-key-here
ALGORITHM=HS256

# Groq API for LLM Summarization
GROQ_API_KEY=gsk_your_production_groq_api_key

# SendGrid for Email Delivery
SENDGRID_API_KEY=SG.your_production_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@newsagent.io

# Redis for Caching and Celery (Optional, but recommended)
REDIS_URL=redis://railway-redis-host:6379

# Environment
ENVIRONMENT=production

# CORS Configuration
ALLOWED_ORIGINS=https://newsagent.io,https://www.newsagent.io

# Logging
LOG_LEVEL=info
