# Database
DATABASE_URL=postgresql://user:password@localhost:5432/news_agent_db
SQLALCHEMY_ECHO=False

# Security & JWT
# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# External APIs
GROQ_API_KEY=
SENDGRID_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# CORS
# Comma-separated list of allowed origins (only used in production)
ALLOWED_ORIGINS=http://localhost:3000

# App Settings
DEBUG=False
ENVIRONMENT=development
